{
  "schema_version": 1,
  "scope": "isolated-legacy-headers",
  "cases": [
    {
      "id": "utf16",
      "header": "tools/icg_baseline/characters/fixtures/Utf16.hh",
      "covers": [
        "char16_t scalar and fixed-array code-unit storage",
        "scalar and array aliases",
        "real MemoryManager code-unit checkpoint round trips"
      ]
    },
    {
      "id": "wide",
      "header": "tools/icg_baseline/characters/fixtures/Wide.hh",
      "covers": [
        "wchar_t legacy metadata",
        "explicit generation rejection and runtime limitation"
      ]
    },
    {
      "id": "utf32",
      "header": "tools/icg_baseline/characters/fixtures/Utf32.hh",
      "covers": [
        "char32_t legacy metadata",
        "explicit generation rejection and runtime limitation"
      ]
    }
  ],
  "artifacts": [
    {
      "id": "legacy-metadata",
      "required": true,
      "patterns": [
        "build/**/io_*.cpp"
      ]
    },
    {
      "id": "registry",
      "required": true,
      "patterns": [
        "build/class_map.cpp"
      ]
    },
    {
      "id": "registry-declarations",
      "required": true,
      "patterns": [
        "build/extern_init_attr.h"
      ]
    },
    {
      "id": "icg-make",
      "required": true,
      "patterns": [
        "build/Makefile_io_src"
      ]
    },
    {
      "id": "icg-dependencies",
      "required": true,
      "patterns": [
        "build/Makefile_ICG"
      ]
    },
    {
      "id": "icg-link",
      "required": true,
      "patterns": [
        "build/io_link_list",
        "build/trickify_io_link_list"
      ]
    },
    {
      "id": "icg-processed",
      "required": true,
      "patterns": [
        "build/ICG_processed"
      ]
    },
    {
      "id": "icg-policy",
      "required": false,
      "patterns": [
        "build/ICG_ext_lib",
        "build/ICG_no_found"
      ]
    },
    {
      "id": "sie-classes",
      "required": true,
      "patterns": [
        "build/classes.resource"
      ]
    }
  ]
}
