# ThreadSanitizer suppressions for the variable server baseline.
#
# CPython is not built with TSan, so TSan cannot see the GIL. Code that only
# runs while a thread holds the GIL looks racy to TSan. Suppress reports
# whose stack is all in libpython, and reports in SWIG's runtime helpers,
# which Python calls only with the GIL held.
called_from_lib:libpython3
race:SwigPyObject_New
race:SwigPyObject_dealloc
race:SWIG_Python_NewShadowInstance
race:SWIG_Python_NewPointerObj
race:SWIG_Python_TypeQuery
race:SWIG_Py_Void
race:SwigPyObject_own
race:SWIG_Python_ConvertPtrAndOwn

# Rewrite Phase 5 soak (soak/vs_soak.py). These races are outside the
# variable server's own state:
#
# * A copy reads simulation memory while the simulation writes it: a model on
#   the main thread, or a client's Python line on its session runner (SWIG
#   setters and var_set called from Python). Trick does not lock model
#   memory; the old server read it the same way. The variable server's own
#   state is never shared this way: a checkpoint load takes the memory lock
#   for writing, and a typed var_set takes it for writing too.
race:Trick::vs::Snapshot::add
# * The message system stamps each message with the executive's time, read
#   without synchronization from whatever thread publishes.
race:Trick::MessagePublisher::publish
# * A checkpoint load rewrites the ThreadBase fields of Trick threads that are
#   running (MessageListen reads its priority).
race:Trick::ThreadBase::execute_priority
# * trick.stop() (and the sim control panel's Stop) sets the executive's stop
#   time from a variable server session thread, without synchronization.
race:Trick::Executive::stop

# Phase 6 (sanitizer CI is a gate). These races are outside the variable
# server's own state too:
#
# * trick.exec_freeze(), trick.exec_run() and trick.checkpoint() from a
#   client's Python line (the sim control panel's buttons, TrickOps) set the
#   executive's mode and command, or write a checkpoint, on the session's
#   thread while the main thread runs. The executive and the checkpoint
#   writer do not lock; the old server ran these lines the same way.
race:exec_freeze
race:exec_run
race:Trick::Executive::checkpoint
race:Trick::ClassicCheckPointAgent::is_nil_valued
race:Trick::ClassicCheckPointAgent::assign_rvalue
# * The real-time itimer's signal handler reads ITimer fields that
#   ITimer::init writes, without synchronization, and does not save errno.
race:Trick::ITimer::semaphore_post
signal:it_handler
