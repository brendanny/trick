{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "policy_version",
    "facts",
    "request",
    "settings",
    "input_digest",
    "files",
    "declarations",
    "digest",
    "template_instances"
  ],
  "properties": {
    "schema_version": {
      "const": 8
    },
    "kind": {
      "const": "legacy-metadata-policy"
    },
    "policy_version": {
      "const": "scalar-metadata-8"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_digest",
        "input_digest",
        "graph_digest"
      ],
      "properties": {
        "schema_version": {
          "const": 12
        },
        "document_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "graph_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_ids",
        "outputs",
        "offset_mode",
        "policy_version",
        "template_field_ids"
      ],
      "properties": {
        "file_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^file:[a-f0-9]{64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "outputs": {
          "enum": [
            [
              "attributes",
              "enum-attributes"
            ],
            [
              "lifecycle"
            ],
            [
              "attributes",
              "enum-attributes",
              "lifecycle"
            ],
            [
              "template-attributes"
            ]
          ]
        },
        "offset_mode": {
          "const": "numeric"
        },
        "policy_version": {
          "const": "scalar-metadata-8"
        },
        "template_field_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^decl:[a-f0-9]{64}$"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "paths",
        "ignore_types"
      ],
      "properties": {
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "TRICK_EXCLUDE": {
              "type": "string"
            },
            "TRICK_ICG_EXCLUDE": {
              "type": "string"
            },
            "TRICK_SYSTEM_ICG_EXCLUDE": {
              "type": "string"
            },
            "TRICK_EXT_LIB_DIRS": {
              "type": "string"
            },
            "TRICK_EXT_LIB_DIRS_OVERRIDES": {
              "type": "string"
            },
            "TRICK_ICG_NOCOMMENT": {
              "type": "string"
            },
            "TRICK_ICG_COMPAT15": {
              "type": "string"
            },
            "TRICK_ICG_IGNORE_TYPES": {
              "type": "string"
            }
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "setting",
              "spelled",
              "resolved",
              "kind"
            ],
            "properties": {
              "setting": {
                "type": "string"
              },
              "spelled": {
                "type": "string"
              },
              "resolved": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "file",
                  "directory",
                  "missing"
                ]
              }
            }
          }
        },
        "ignore_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "excluded",
          "rule",
          "header_comment",
          "no_comment",
          "ignore_types",
          "path_evidence",
          "no_comment_rule"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^file:[a-f0-9]{64}$"
          },
          "excluded": {
            "type": "boolean"
          },
          "rule": {
            "type": "string"
          },
          "header_comment": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "no_comment": {
            "type": "boolean"
          },
          "ignore_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_evidence": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "no_comment_rule": {
            "type": "string"
          }
        }
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "declaration_id",
          "decision",
          "rule",
          "source",
          "parent_id",
          "metadata"
        ],
        "properties": {
          "declaration_id": {
            "type": "string",
            "pattern": "^decl:[a-f0-9]{64}$"
          },
          "decision": {
            "enum": [
              "include",
              "omit"
            ]
          },
          "rule": {
            "enum": [
              "NOT_REQUESTED",
              "NOT_METADATA_DECLARATION",
              "FILE_EXCLUDED",
              "PARENT_OMITTED",
              "ICG_IGNORE_TYPES",
              "INACCESSIBLE_NESTED_TYPE",
              "UNNAMED_ENUM",
              "OPAQUE_ENUM_DECLARATION",
              "INCOMPLETE_TYPE",
              "REQUESTED_METADATA",
              "IO_DISABLED",
              "NUMERIC_OFFSET_METADATA",
              "OUTPUT_NOT_REQUESTED"
            ]
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/$defs/source"
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^decl:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "symbol",
                  "init_function",
                  "lifecycle"
                ],
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "init_function": {
                    "type": "string"
                  },
                  "lifecycle": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/lifecycle"
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type_id",
                  "comment_index",
                  "annotation",
                  "access",
                  "storage",
                  "units_map_key"
                ],
                "properties": {
                  "type_id": {
                    "type": "string",
                    "pattern": "^type:[a-f0-9]{64}$"
                  },
                  "comment_index": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "annotation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "units",
                      "io",
                      "rules",
                      "diagnostics",
                      "mods",
                      "description"
                    ],
                    "properties": {
                      "units": {
                        "type": "string"
                      },
                      "io": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 15
                      },
                      "rules": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "diagnostics": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "LEGACY_UNKNOWN_IO_ZERO",
                            "LEGACY_UNIT_ALIAS",
                            "LEGACY_DASHDASH_IO",
                            "LEGACY_INVALID_UNITS_DEFAULT"
                          ]
                        }
                      },
                      "mods": {
                        "enum": [
                          0,
                          4
                        ]
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  },
                  "access": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "operation",
                      "allowed",
                      "rule",
                      "friend_indices",
                      "legacy_prefix_indices",
                      "compatibility"
                    ],
                    "properties": {
                      "operation": {
                        "const": "member-access-in-init-attributes"
                      },
                      "allowed": {
                        "type": "boolean"
                      },
                      "rule": {
                        "enum": [
                          "PUBLIC_MEMBER",
                          "EXACT_INIT_FRIEND",
                          "NO_ACCESS_GRANT"
                        ]
                      },
                      "friend_indices": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "legacy_prefix_indices": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "compatibility": {
                        "enum": [
                          null,
                          "LEGACY_PREFIX_IS_NOT_ACCESS"
                        ]
                      }
                    }
                  },
                  "storage": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/field_storage"
                      },
                      {
                        "$ref": "#/$defs/structured_storage"
                      }
                    ]
                  },
                  "units_map_key": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "symbol",
                  "init_function",
                  "enum"
                ],
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "init_function": {
                    "type": "null"
                  },
                  "enum": {
                    "$ref": "#/$defs/enum_metadata"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_id",
          "record_id",
          "primary_template_id",
          "argument_type_ids",
          "cpp_type",
          "symbol",
          "init_function",
          "fields",
          "requested_field_ids",
          "dependency_path",
          "dependency_record_ids"
        ],
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^decl:[a-f0-9]{64}$"
          },
          "record_id": {
            "type": "string",
            "pattern": "^decl:[a-f0-9]{64}$"
          },
          "primary_template_id": {
            "type": "string",
            "pattern": "^decl:[a-f0-9]{64}$"
          },
          "argument_type_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^type:[a-f0-9]{64}$"
            }
          },
          "cpp_type": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "init_function": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/properties/declarations/items"
            }
          },
          "requested_field_ids": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^decl:[a-f0-9]{64}$"
            }
          },
          "dependency_path": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^decl:[a-f0-9]{64}$"
            }
          },
          "dependency_record_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^decl:[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasa.github.io/trick/icg/resolved-policy-v8.schema.json",
  "title": "Bounded legacy metadata, lifecycle and template-use policy v8",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spelling",
        "expansion",
        "end",
        "macro_expansion"
      ],
      "properties": {
        "spelling": {
          "$ref": "#/$defs/point"
        },
        "expansion": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        },
        "macro_expansion": {
          "type": "boolean"
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "line",
        "column",
        "offset"
      ],
      "properties": {
        "file_id": {
          "$ref": "#/$defs/id"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z]+:[^\\s]+$"
    },
    "enum_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_rule",
        "diagnostics",
        "mods",
        "rows"
      ],
      "properties": {
        "label_rule": {
          "const": "LEGACY_CONTAINER_SCOPE"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "const": "LEGACY_SCOPED_LABEL_OMITS_ENUM"
          }
        },
        "mods": {
          "enum": [
            0,
            1073741824
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_index",
              "label",
              "cpp_name",
              "value"
            ],
            "properties": {
              "source_index": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "cpp_name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)$"
              }
            }
          }
        }
      }
    },
    "field_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_type_id",
        "type_name",
        "cpp_type",
        "trick_type",
        "dimensions"
      ],
      "properties": {
        "element_type_id": {
          "type": "string",
          "pattern": "^type:[a-f0-9]{64}$"
        },
        "type_name": {
          "enum": [
            "int",
            "unsigned int",
            "double"
          ]
        },
        "cpp_type": {
          "type": "string",
          "minLength": 1
        },
        "trick_type": {
          "enum": [
            "TRICK_INTEGER",
            "TRICK_UNSIGNED_INTEGER",
            "TRICK_DOUBLE",
            "TRICK_UNSIGNED_BITFIELD"
          ]
        },
        "dimensions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "default_constructor",
        "destructor",
        "default_placement",
        "allocate",
        "destruct",
        "delete"
      ],
      "properties": {
        "domain": {
          "const": "positive-count-nonthrowing"
        },
        "default_constructor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "special_member_index",
            "declaration_ids",
            "available",
            "rule",
            "virtual"
          ],
          "properties": {
            "special_member_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "declaration_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "maxItems": 1
            },
            "available": {
              "type": "boolean"
            },
            "rule": {
              "enum": [
                "NO_DECLARED_SPECIAL_MEMBER",
                "DELETED_SPECIAL_MEMBER",
                "NON_PUBLIC_SPECIAL_MEMBER",
                "PUBLIC_SPECIAL_MEMBER"
              ]
            },
            "virtual": {
              "type": "boolean"
            }
          }
        },
        "destructor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "special_member_index",
            "declaration_ids",
            "available",
            "rule",
            "virtual"
          ],
          "properties": {
            "special_member_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "declaration_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "maxItems": 1
            },
            "available": {
              "type": "boolean"
            },
            "rule": {
              "enum": [
                "NO_DECLARED_SPECIAL_MEMBER",
                "DELETED_SPECIAL_MEMBER",
                "NON_PUBLIC_SPECIAL_MEMBER",
                "PUBLIC_SPECIAL_MEMBER"
              ]
            },
            "virtual": {
              "type": "boolean"
            }
          }
        },
        "default_placement": {
          "type": "boolean"
        },
        "allocate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "symbol",
            "action",
            "rule"
          ],
          "properties": {
            "symbol": {
              "type": "string",
              "pattern": "^io_src_[A-Za-z0-9_]+$"
            },
            "action": {
              "enum": [
                "absent",
                "raw_storage",
                "construct"
              ]
            },
            "rule": {
              "enum": [
                "NO_DECLARED_SPECIAL_MEMBER",
                "DELETED_SPECIAL_MEMBER",
                "NON_PUBLIC_SPECIAL_MEMBER",
                "PUBLIC_SPECIAL_MEMBER",
                "LEGACY_POD_RAW_STORAGE",
                "ABSTRACT_RECORD",
                "LEGACY_POD_NOOP",
                "FORWARD_DESTRUCTION_NO_FREE",
                "SCALAR_NEW_OWNERSHIP"
              ]
            }
          }
        },
        "destruct": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "symbol",
            "action",
            "rule"
          ],
          "properties": {
            "symbol": {
              "type": "string",
              "pattern": "^io_src_[A-Za-z0-9_]+$"
            },
            "action": {
              "enum": [
                "absent",
                "noop",
                "loop"
              ]
            },
            "rule": {
              "enum": [
                "NO_DECLARED_SPECIAL_MEMBER",
                "DELETED_SPECIAL_MEMBER",
                "NON_PUBLIC_SPECIAL_MEMBER",
                "PUBLIC_SPECIAL_MEMBER",
                "LEGACY_POD_RAW_STORAGE",
                "ABSTRACT_RECORD",
                "LEGACY_POD_NOOP",
                "FORWARD_DESTRUCTION_NO_FREE",
                "SCALAR_NEW_OWNERSHIP"
              ]
            }
          }
        },
        "delete": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "symbol",
            "action",
            "rule"
          ],
          "properties": {
            "symbol": {
              "type": "string",
              "pattern": "^io_src_[A-Za-z0-9_]+$"
            },
            "action": {
              "enum": [
                "absent",
                "noop",
                "scalar"
              ]
            },
            "rule": {
              "enum": [
                "NO_DECLARED_SPECIAL_MEMBER",
                "DELETED_SPECIAL_MEMBER",
                "NON_PUBLIC_SPECIAL_MEMBER",
                "PUBLIC_SPECIAL_MEMBER",
                "LEGACY_POD_RAW_STORAGE",
                "ABSTRACT_RECORD",
                "LEGACY_POD_NOOP",
                "FORWARD_DESTRUCTION_NO_FREE",
                "SCALAR_NEW_OWNERSHIP"
              ]
            }
          }
        }
      }
    },
    "structured_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_type_id",
        "type_name",
        "cpp_type",
        "trick_type",
        "dimensions",
        "record_id"
      ],
      "properties": {
        "element_type_id": {
          "type": "string",
          "pattern": "^type:[a-f0-9]{64}$"
        },
        "type_name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "cpp_type": {
          "type": "string",
          "minLength": 1
        },
        "trick_type": {
          "const": "TRICK_STRUCTURED"
        },
        "dimensions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "record_id": {
          "type": "string",
          "pattern": "^decl:[a-f0-9]{64}$"
        }
      }
    }
  }
}
