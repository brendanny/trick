CONFIG_MK = 1
CC = @CMAKE_C_COMPILER@
CXX = @CMAKE_CXX_COMPILER@
TRICK_CC ?= @CMAKE_C_COMPILER@
TRICK_CXX ?= @CMAKE_CXX_COMPILER@
PERL = @PERL_EXECUTABLE@
SWIG = @SWIG_EXECUTABLE@
PYTHON = @TRICK_SDK_PYTHON_EXECUTABLE@
TEE = tee
USE_ER7_UTILS = @TRICK_USE_ER7_UTILS@
TRICK_FORCE_32BIT = OFF
USE_JAVA = 0
USE_X_WINDOWS = 0
USE_CIVETWEB = 0
PYTHON_INCLUDES = @sdk_python_includes@
PYTHON_LIB = $<TARGET_FILE:Trick::Python>
UDUNITS_INCLUDES = @sdk_udunits_includes@
UDUNITS_LDFLAGS = @UDUNITS2_LIBRARY@
TRICK_ADDITIONAL_CFLAGS = @CMAKE_C_FLAGS@ @sdk_platform_make_flags@
TRICK_ADDITIONAL_CXXFLAGS = @CMAKE_CXX_FLAGS@ @sdk_platform_make_flags@ -std=c++17
TRICK_GCC_VERSION = @CMAKE_CXX_COMPILER_VERSION@
