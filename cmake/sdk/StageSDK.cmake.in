cmake_minimum_required(VERSION 3.26)
set(sdk "@TRICK_SDK_ROOT@")
string(REGEX REPLACE "/+$" "" sdk "${sdk}")

function(stage_link target relative)
    set_property(GLOBAL APPEND PROPERTY sdk_files "${relative}")
    set(destination "${sdk}/${relative}")
    if(IS_SYMLINK "${destination}")
        file(READ_SYMLINK "${destination}" previous)
        if(previous STREQUAL target)
            return()
        endif()
    endif()
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(REMOVE "${destination}")
    file(CREATE_LINK "${target}" "${destination}" SYMBOLIC)
endfunction()

function(stage_file source relative)
    if(IS_SYMLINK "${source}")
        # Materialize source links: their targets may lie outside the SDK's
        # copied trees, so preserving relative link text can produce broken links.
        file(REAL_PATH "${source}" source)
        if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
            message(FATAL_ERROR "SDK resource symlink must resolve to a file: ${source}")
        endif()
    endif()
    set_property(GLOBAL APPEND PROPERTY sdk_files "${relative}")
    set(destination "${sdk}/${relative}")
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    if(IS_SYMLINK "${destination}")
        file(REMOVE "${destination}")
    endif()
    # Preserve the mtime of unchanged files: simulation Make dependencies point
    # at the SDK's generator, configuration and Python proxies.
    file(COPY_FILE "${source}" "${destination}" ONLY_IF_DIFFERENT)
endfunction()

function(stage_tree source relative headers_only)
    file(GLOB_RECURSE files RELATIVE "${source}" LIST_DIRECTORIES false "${source}/*")
    foreach(file IN LISTS files)
        if(file MATCHES "(^|/)(__pycache__|\\.venv)(/|$)" OR
           "${relative}/${file}" STREQUAL "share/trick/makefiles/config_user.mk")
            continue()
        endif()
        if(headers_only)
            if(NOT file MATCHES "\\.(h|hh|hpp|ipp)$" OR file MATCHES "(^|/)(test|tests)(/|$)")
                continue()
            endif()
            if(NOT "@TRICK_USE_ER7_UTILS@" AND file MATCHES "^er7_utils/")
                continue()
            endif()
        endif()
        stage_file("${source}/${file}" "${relative}/${file}")
        if(relative STREQUAL "include" OR headers_only)
            # SDK headers stay writable even when CI makes production sources read-only.
            file(CHMOD "${sdk}/${relative}/${file}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
        endif()
    endforeach()
endfunction()

# Copy scripts rather than link them: their RealBin must identify this SDK.
foreach(script IN ITEMS trick-CP trick-config trick-gte trick-ify trick-killsim trick-units trick-version)
    stage_file("@PROJECT_SOURCE_DIR@/bin/${script}" "bin/${script}")
endforeach()
stage_tree("@PROJECT_SOURCE_DIR@/libexec" libexec FALSE)
stage_tree("@PROJECT_SOURCE_DIR@/share" share FALSE)
stage_tree("@PROJECT_SOURCE_DIR@/include" include FALSE)
stage_tree("@PROJECT_SOURCE_DIR@/trick_source" trick_source TRUE)
stage_file("@PROJECT_BINARY_DIR@/sdk-config/$<CONFIG>/config_user.mk" "share/trick/makefiles/config_user.mk")
stage_file("@PROJECT_BINARY_DIR@/sdk-config/$<CONFIG>/cmake-sdk.mk" "share/trick/makefiles/cmake-sdk.mk")
stage_file("@PROJECT_BINARY_DIR@/sdk-model-predefines.txt" "share/trick/model-predefines.txt")
stage_file("@PROJECT_BINARY_DIR@/sdk-config/$<CONFIG>/sdk.env" "share/trick/sdk.env")
@sdk_stage_libraries@
stage_file("$<TARGET_FILE:trick-ICG>" "bin/trick-ICG")
stage_file("@PROJECT_BINARY_DIR@/trick_source/sim_services/metadata/$<CONFIG>/classes.resource"
    "share/trick/xml/sim_services_classes.resource")
foreach(module IN ITEMS sim_services swig_double swig_int swig_ref)
    stage_file("@PROJECT_BINARY_DIR@/python/${module}.py" "share/trick/swig/${module}.py")
endforeach()

# Remove only files owned by the preceding SDK inventory, preserving any user outputs.
set(manifest "@PROJECT_BINARY_DIR@/sdk-config/$<CONFIG>/staged-files.txt")
get_property(files GLOBAL PROPERTY sdk_files)
list(REMOVE_DUPLICATES files)
list(SORT files)
if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" previous)
    foreach(old IN LISTS previous)
        if(NOT old IN_LIST files)
            file(REMOVE "${sdk}/${old}")
            get_filename_component(parent "${sdk}/${old}" DIRECTORY)
            while(NOT parent STREQUAL sdk AND IS_DIRECTORY "${parent}" AND NOT IS_SYMLINK "${parent}")
                file(GLOB children "${parent}/*")
                if(children)
                    break()
                endif()
                file(REMOVE_RECURSE "${parent}")
                get_filename_component(parent "${parent}" DIRECTORY)
            endwhile()
        endif()
    endforeach()
endif()
list(JOIN files "\n" inventory)
set(inventory "${inventory}\n")
set(previous_inventory "")
if(EXISTS "${manifest}")
    file(READ "${manifest}" previous_inventory)
endif()
if(NOT inventory STREQUAL previous_inventory)
    file(WRITE "${manifest}" "${inventory}")
endif()
