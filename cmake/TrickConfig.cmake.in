@PACKAGE_INIT@
if(CMAKE_VERSION VERSION_LESS 3.26)
    message(FATAL_ERROR "Trick requires CMake 3.26 or newer")
endif()
set(Trick_VERSION "@PROJECT_VERSION@")
set(Trick_VERSION_STRING "@TRICK_VERSION@")
set(Trick_PYTHON_DIR "@PACKAGE_trick_package_python_dir@")
include(CMakeFindDependencyMacro)
if(NOT Trick_FIND_COMPONENTS)
    set(Trick_FIND_COMPONENTS Runtime)
endif()
set(Trick_Utilities_FOUND TRUE)
set(Trick_Runtime_FOUND TRUE)
set(Trick_ICG_FOUND TRUE)
foreach(component IN LISTS Trick_FIND_COMPONENTS)
    if(NOT component MATCHES "^(Utilities|Runtime|ICG)$")
        set(Trick_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(Trick)
if(DEFINED Trick_FOUND AND NOT Trick_FOUND)
    return()
endif()
find_dependency(Threads)
if("Runtime" IN_LIST Trick_FIND_COMPONENTS)
    # No LLVM, Clang, SWIG, Bison, Flex, or interpreter discovery for consumers.
    find_dependency(@python_package@ @Trick_PYTHON_VERSION@ EXACT COMPONENTS Development.Embed)
    block(SCOPE_FOR VARIABLES)
        list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
        find_dependency(UDUNITS2)
    endblock()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TrickTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/TrickRuntime.cmake")
set(Trick_PYTHON_MAJOR "@TRICK_PYTHON_MAJOR@")
set(Trick_USE_ER7_UTILS "@TRICK_USE_ER7_UTILS@")
